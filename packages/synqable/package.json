{
	"name": "synqable",
	"version": "0.0.13",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"named-logs": "^0.4.1",
		"object-hash": "^3.0.0",
		"radiate": "^0.3.0"
	},
	"devDependencies": {
		"@types/node": "^25.2.0",
		"@types/object-hash": "^3.0.6",
		"as-soon": "^0.1.5",
		"cross-env": "^10.1.0",
		"prettier": "^3.8.0",
		"tsx": "^4.21.0",
		"typescript": "^5.3.3",
		"viem": "^2.0.0",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "tsc",
		"dev": "as-soon -w src pnpm build",
		"test:typecheck": "tsc --project tsconfig.check.json",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
