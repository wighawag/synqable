{
	"name": "synqable-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"devDependencies": {
		"@changesets/cli": "^2.29.8"
	},
	"scripts": {
		"prepublishOnly": "pnpm format:check && pnpm build && cp ./README.md packages/synqable/README.md",
		"release": "node scripts/release.mjs all",
		"release:prepare": "node scripts/release.mjs prepare",
		"release:publish": "node scripts/release.mjs publish",
		"format": "pnpm run -r format",
		"format:check": "pnpm run -r format:check",
		"build": "pnpm run -r build",
		"dev": "pnpm run -r dev",
		"test": "pnpm run -r test",
		"test:typecheck": "pnpm run -r test:typecheck"
	}
}
